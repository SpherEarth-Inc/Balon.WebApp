# Site URL for metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://football.spherearth.ca

# Calendly embed URL for parent consultation booking
# Example: https://calendly.com/your-org/parent-consultation
NEXT_PUBLIC_CALENDLY_URL=

# HubSpot form integration (optional, Phase 2)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_FORM_ID=

# Academy portal login (external Next.js server app, not this static site)
# The header "Log In" button links here. Defaults to https://balon.spherearth.ca
NEXT_PUBLIC_APP_LOGIN_URL=https://balon.spherearth.ca

# Balon Domain API (public forms + news)
# Production: https://balon-domain-api.spherearth.ca
NEXT_PUBLIC_DOMAIN_API_URL=https://balon-domain-api.spherearth.ca

# Ad platform tracking (all optional; each tag loads only when its id is set)
# LinkedIn Insight Tag partner id + event-specific conversion id for the
# Admissions Advisor Expression of Interest.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_ADVISOR_CONVERSION_ID=
# Meta Pixel id from Events Manager. Covers both Facebook and Instagram ads;
# the advisor conversion fires the standard "Lead" event (no separate id).
NEXT_PUBLIC_META_PIXEL_ID=
# X/Twitter base pixel id + conversion event id for the advisor EOI.
NEXT_PUBLIC_TWITTER_PIXEL_ID=
NEXT_PUBLIC_TWITTER_ADVISOR_EVENT_ID=
